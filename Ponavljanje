



ž#include <iostream>
using namespace std;

void zrcalo(int n)
{
	cout << n % 10;
	if (n < 10)
	{
		return;
	}
	else
	{
		zrcalo(n / 10);
	}
}

int main()
{
	int n;
	cin >> n;
	zrcalo(n);
	return 0;
}






#include <iostream>
#include <vector>
using namespace std;

int BrojPozitivnih(const vector <int>& a, int i)
{
	if (a.size() == i)
	{
		return 0;
	}
	if (a[i] > 0)
	{
		return a[i] + BrojPozitivnih(a, i + 1);
	}
	else
	{
		return BrojPozitivnih(a, i + 1);
	}
}

int main()
{
	int n;
	cin >> n;
	vector <int> a;
	for (int i = 0;i < n;i++)
	{
		int x;
		cin >> x;
		a.push_back(x);
	}
	cout << BrojPozitivnih(a, 0);
	return 0;
}









#include <iostream>
#include <vector>
using namespace std;

long long nacini(int n)
{
	if(n == 0)
	{
		return 1;
	}
	else if (n < 0)
	{
		return 0;
	}
	else
	{
		return nacini(n - 1) + nacini(n - 2);
	}
}

int main()
{
	int n;
	cin >> n;
	cout << nacini(n);
	return 0;
}

