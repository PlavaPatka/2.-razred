using namespace std;

int sigurno(int xmin, int ymin, int xmax, int ymax, int xtemp, int ytemp)
{
       if(xtemp==xmin || xtemp==xmax || ytemp==ymin || ytemp==ymax)
   {
       return 1;
   }
   if (xtemp>=xmin && xtemp<=xmax && ytemp>=ymin && ytemp<=ymax)
