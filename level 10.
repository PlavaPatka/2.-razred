#include <iostream>
#include <vector>
using namespace std;

void najbolji(const vector<int> a, int n)
{
    int kulkovelikih = 0;
    int veliki = 0;
    int velikip = 0;

    for (int i = 0; i < n; i++)
    {
        if (a[i] > veliki)
        {
            veliki = a[i];
            velikip = i;
            kulkovelikih = 1;
        }
        else if (a[i] == veliki)
        {
            kulkovelikih++;
        }
    }

    cout << "NAJBOLJI: " << veliki << endl;
    cout << "POZICIJA: " << velikip + 1 << endl;
    cout << "KULKO ISTIH VELIKI: " << kulkovelikih << endl;
}

int prolaz(const vector<int> a, int n, int p)
{
    if (n == 0)
    {
        return 0;
    }
    if (a[n-1] >= p)
    {
        return 1 + prolaz(a, n-1, p);
    }
    else
    {
        return prolaz(a, n - 1, p);
    }
}

int main()
{
    vector<int> polje;
    int n, p;

    cin >> n >> p;

    for (int i = 0; i < n; i++)
    {
        int x;
        cin >> x;
        polje.push_back(x);
    }

    najbolji(polje, n);
    cout << "PROLAZ: " << prolaz(polje, n, p);
}




