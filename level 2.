
SENZORI



#include <iostream>
using namespace std;

int senzor(int a, int b, int c)
{
    if(a==b || a==c)
    {
        return a;
    }
    else if(b==c)
    {
        return b;
    }
    else
    {
        return (a+b+c)/3;
    }
}

int main()
{
int senzor1, senzor2, senzor3;
cin >> senzor1 >> senzor2 >> senzor3;
cout << senzor(senzor1, senzor2, senzor3);
return 0;
}



