


AI filter 





#include <iostream>
#include <string>
using namespace std;

bool prihvatljivo(string poruka)
{
    if (poruka[0] == ' ')
    {
        return false;
    }
    if (poruka.length() > 40)
    {
        return false;
    }
    int i = 0;
    while(1)
    {
        if (poruka[i] == '#')
        {
            return false;
        }
        if (poruka[i] == '\0')
        {
            return true;
        }
        i++;
    }
}

int main()
{
    string poruka;
    getline(cin, poruka);
    cout << prihvatljivo(poruka);
    return 0;
}





PAMETNI SENZOR





#include <iostream>
#include <string>
using namespace std;

bool temperatura(int n, char mj)
{
	if (mj=='K')
	{
		return false;
	}
	if (mj == 'C')
	{
		if (n > -40 && n < 85)
		{
			return true;
		}
	}
	if (mj == 'F')
	{
		if (n > -40 && n < 185)
		{
			return true;
		}
	}
	return false;
}

int main()
{
	int temp;
	char tempmj;
	cin >> temp >> tempmj;
	cout << temperatura(temp, tempmj);
	return 0;
}






DNA UZORAK








#include <iostream>
#include <string>
using namespace std;

bool deoksiribonukleinskakiselina(string dna)
{
	int GCjiji=0;
	int i = 0;
	if (dna.length() >= 6 && dna.length() <= 30)
	{
		while (1)
		{
			if (dna[i] == 'A' || dna[i] == 'C' || dna[i] == 'G' || dna[i] == 'T')
			{
				if (dna[i] == 'C' || dna[i] == 'G')
				{
					GCjiji++;
				}
			}
			else
			{
				return false;
			}
			if (dna[i] == '\0')
			{
				break;
			}
			i++;
		}
	}
	if (GCjiji * 2 >= dna.length())
	{
		return true;
	}
	return false;
}

int main()
{
	string dna;
	cin >> dna;
	cout << deoksiribonukleinskakiselina(dna);
	return 0;
}
