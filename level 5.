#include <iostream>
#include <string>
#include <vector>
using namespace std;

int stanice(const vector<int>& v, int K)
{
	int n=0;
	for (int i = 0;i < v.size();i++)
	{
		if (v[i] >= K)
		{
			return n;
		}
		n++;
	}
	return -1;
}


int main()
{
	int n, K;
	cin >> n >> K;
	vector <int> v;
	int temp;
	for (int i = 0;i < n;i++)
	{
		cin >> temp;
		v.push_back(temp);
	}
	cout << stanice(v, K);
	return 0;
}





