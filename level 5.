




PUNIONICE ZA E BICIKLE






#include <iostream>
#include <string>
#include <vector>
using namespace std;

int stanice(const vector<int>& v, int K)
{
	int n=0;
	for (int i = 0;i < v.size();i++)
	{
		if (v[i] >= K)
		{
			return n;
		}
		n++;
	}
	return -1;
}


int main()
{
	int n, K;
	cin >> n >> K;
	vector <int> v;
	int temp;
	for (int i = 0;i < n;i++)
	{
		cin >> temp;
		v.push_back(temp);
	}
	cout << stanice(v, K);
	return 0;
}





SIGNAL U TUNELU






#include <iostream>
#include <string>
using namespace std;

int signal(int polje[], int n, int D)
{
	for (int i = 0;i < n;i++)
		if (abs(polje[i]-polje[i+1])>D)
		{
			return i+1;
		}
	return -1;
}


int main()
{
	int n, D;
	cin >> n >> D;
	int polje[1000];
	for (int i = 0;i < n;i++)
	{
		cin >> polje[i];
	}
	cout << signal(polje, n ,D);
	return 0;
}





AUTONOMNI ROVER





#include <iostream>
#include <string>
using namespace std;

int senzori(int polje[1000][4], int n, int D)
{
	int i = 0;
	for (int j = 0;j < n;j++)
	{
		if (abs(polje[j][i] - polje[j][i + 1]) < D && abs(polje[j][i + 1] - polje[j][i + 2]) < D && abs(polje[j][i + 2] - polje[j][i + 3]) < D)
		{
			return j;
		}
	}
	return -1;
}


int main()
{
	int n, D;
	cin >> n >> D;
	int polje[1000][4];
	for (int i = 0;i < n;i++)
	{
		for (int j = 0;j < 4;j++)
		{
			cin >> polje[i][j];
		}
	}
	cout << senzori(polje, n, D);
	return 0;
}
