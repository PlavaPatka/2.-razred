REŠENO Z VEKTORAJ







#include <iostream>
#include <vector>
using namespace std;

void najbolji(vector<int> a, int n)
{
    int kulkovelikih = 0;
    int veliki = 0;
    int velikip = 0;

    for (int i = 0; i < n; i++)
    {
        if (a[i] > veliki)
        {
            veliki = a[i];
            velikip = i;
            kulkovelikih = 1;
        }
        else if (a[i] == veliki)
        {
            kulkovelikih++;
        }
    }

    cout << "NAJBOLJI: " << veliki << endl;
    cout << "POZICIJA: " << velikip + 1 << endl;
    cout << "KULKO ISTIH VELIKI: " << kulkovelikih << endl;
}

void prolaz(vector<int> a, int n, int p)
{
    int broj = 0;

    for (int i = 0; i < n; i++)
    {
        if (a[i] >= p)
        {
            broj++;
        }
    }

    cout << "PROLAZ: " << broj;
}

int main()
{
    vector<int> polje;
    int n, p;

    cin >> n >> p;

    for (int i = 0; i < n; i++)
    {
        int x;
        cin >> x;
        polje.push_back(x);
    }

    najbolji(polje, n);
    prolaz(polje, n, p);
}
